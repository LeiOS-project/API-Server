LRA_LOG_LEVEL=info

# The Hub's public URL: CORS origin and base of the links in emails.
# (Replaces LRA_HUB_URL, which still works for now but logs a deprecation warning.)
LRA_APP_URL=http://localhost:12153

LRA_API_HOST=::
LRA_API_PORT=12151
# Booleans: exactly "true" or "false" (case-sensitive); anything else — including an empty value — fails at startup.
# An unset variable falls back to the schema default.
LRA_API_DISABLE_DOCS=false
# Set to true when the API runs behind a reverse proxy that sets X-Forwarded-For, so login, signup
# and report rate limits count per client instead of per proxy. Leave false otherwise.
LRA_API_TRUST_PROXY=false

LRA_LOG_DIR=./data/logs

LRA_DB_PATH=./data/db.sqlite
LRA_DB_AUTO_MIGRATE=true
LRA_DB_MIGRATION_DIR=./drizzle/migrations

LRA_APTLY_ROOT=./data/aptly
# Leave LRA_APTLY_PORT unset (or 0) to bind Aptly to a random free port from the dynamic range
# (49152-65535). Set an explicit port only if needed.
# LRA_APTLY_PORT=12150

LRA_BRANDING_META_FILES_DATA_PATH=./data/branding-meta-files

LRA_CONFIG_BASE_DIR=./config
LRA_PRIVATE_KEY_PATH=./config/keys/private-key.gpg
LRA_PUBLIC_KEY_PATH=./config/keys/public-key.gpg

LRA_S3_ENDPOINT=https://api.s3.leicraftmc.de
LRA_S3_REGION=garage
LRA_S3_BUCKET=leios-repo
LRA_S3_PREFIX=leios/
LRA_S3_ACCESS_KEY_ID=your-access-key-id
LRA_S3_SECRET_ACCESS_KEY=your-secret-access-key

# Self-service signup (POST /v1/auth/signup). Needs email (below) for the verification links;
# it stays closed while LRA_SMTP_HOST is unset.
LRA_SIGNUP_ENABLED=false

# SMTP — optional; email features (password resets, signup verification) stay off while
# LRA_SMTP_HOST is unset.
LRA_SMTP_HOST=smtp.example.com
LRA_SMTP_PORT=587
LRA_SMTP_USERNAME=your-smtp-username
LRA_SMTP_PASSWORD=your-smtp-password
LRA_SMTP_FROM="LeiOS <noreply@leios.dev>"
LRA_SMTP_SECURE=false
